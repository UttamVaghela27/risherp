# ============================================
# RISHERP Frontend - Production Environment Variables (Example)
# ============================================
# Copy this file to .env.production when building for production:
# cp .env.production.example .env.production

# Production Backend API URL (Replace with your actual domain or reverse proxy path)
VITE_API_BASE_URL=https://erp-api.yourdomain.com/api

# Application branding
VITE_APP_NAME=RISHERP
VITE_APP_VERSION=1.0.0
