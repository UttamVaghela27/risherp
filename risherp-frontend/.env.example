# ============================================
# RISHERP Frontend - Environment Variables (Example)
# ============================================
# Copy this file to .env for local development:
# cp .env.example .env

# Backend API base URL
#VITE_API_BASE_URL=https://risherp.onrender.com/api

# Application branding
VITE_APP_NAME=RISHERP
VITE_APP_VERSION=1.0.0

# ============================================
# IMPORTANT: Backend environment variables
# The following variables are for the BACKEND ONLY.
# Do NOT put SMTP credentials or secrets in this frontend .env file.
# Set these as environment variables on your backend server or in
# risherp-backend application.yml using ${ENV_VAR:default} syntax.
# ============================================
#
# Backend SMTP / Email configuration (set on the backend):
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-email@gmail.com
#   MAIL_PASSWORD=your-app-password   (use App Password, not account password)
#   MAIL_FROM=noreply@yourdomain.com
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS_ENABLE=true
#
# Backend JWT (set on the backend):
#   JWT_SECRET=your-at-least-32-character-secret-key
#   JWT_EXPIRATION_MS=86400000
#
# Backend OTP settings (optional; defaults shown):
#   OTP_EXPIRY_MINUTES=10
#   OTP_MAX_ATTEMPTS=5
#   OTP_RESEND_COOLDOWN_SECONDS=60
#
# Gmail setup instructions:
#   1. Enable 2-Factor Authentication on your Google account
#   2. Go to Google Account > Security > App passwords
#   3. Generate an app password for "Mail"
#   4. Use that 16-character app password as MAIL_PASSWORD
#   5. MAIL_USERNAME = your Gmail address
#
# For other SMTP providers (e.g. SendGrid, Mailgun, AWS SES):
#   Update MAIL_HOST and MAIL_PORT accordingly.
#   MAIL_SMTP_STARTTLS_ENABLE=true for port 587 (STARTTLS)
#   For port 465 (SSL): set spring.mail.properties.mail.smtp.ssl.enable=true
