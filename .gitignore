# ==============================================================================
# RISHERP — Enterprise ERP & Billing System
# Root .gitignore for Full-Stack Monorepo (Spring Boot Backend + React Frontend)
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# ------------------------------------------------------------------------------
# IDE, Editor & Tooling Configs
# ------------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.classpath
.project
.settings/
bin/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# Frontend (React / Vite / Node.js)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.eslintcache
**/.eslintcache

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Local Overrides
.env
.env.*
.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# ------------------------------------------------------------------------------
# Backend (Java / Spring Boot / Maven)
# ------------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven Wrapper & Timings
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Crash logs
hs_err_pid*
replay_pid*

# Database & Storage Backups
backups/
**/backups/
!risherp-backend/backups/.gitkeep
*.dump
*.sql.gz

# Temporary / Scratch Files
tmp/
**/tmp/
temp/
**/temp/
*.tmp
